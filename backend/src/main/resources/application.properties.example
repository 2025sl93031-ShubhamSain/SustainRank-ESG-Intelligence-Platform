# Copy this file to application.properties and fill in your values.
# Never commit application.properties — it is in .gitignore.

server.port=8000

# ── PostgreSQL ────────────────────────────────────────────────────────────────
spring.datasource.url=jdbc:postgresql://localhost:5432/sustainability_db
spring.datasource.username=YOUR_DB_USERNAME
spring.datasource.password=YOUR_DB_PASSWORD
spring.datasource.driver-class-name=org.postgresql.Driver

# ── JPA / Hibernate ───────────────────────────────────────────────────────────
spring.jpa.hibernate.ddl-auto=update
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.show-sql=false

# ── Jackson ───────────────────────────────────────────────────────────────────
spring.jackson.serialization.write-dates-as-timestamps=false

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong random hex string (min 64 chars) for production.
jwt.secret=REPLACE_WITH_A_LONG_RANDOM_HEX_SECRET
jwt.expiration-ms=86400000

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. For local dev: http://localhost:5173
cors.allowed-origins=http://localhost:5173

# ── Logging ───────────────────────────────────────────────────────────────────
logging.level.com.sustainability=INFO

# ── AI Recommendations ────────────────────────────────────────────────────────
# Supported providers: openai | gemini | anthropic | ollama
ai.provider=openai
# Your API key (leave blank for ollama)
ai.api-key=YOUR_AI_API_KEY
# Model name — any model the provider supports
#   openai:     gpt-4o, gpt-4o-mini
#   gemini:     gemini-1.5-flash, gemini-1.5-pro
#   anthropic:  claude-sonnet-4-6, claude-haiku-4-5-20251001
#   ollama:     llama3, mistral
ai.model=gpt-4o-mini
# Optional: override base URL (required for ollama, e.g. http://localhost:11434)
ai.base-url=
